<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rommanager.main.DialogConsoleController" stylesheets="@DialogConsole.css">
   <top>
      <VBox spacing="6.0" styleClass="header-panel" BorderPane.alignment="CENTER_LEFT">
         <Label text="Select Consoles" styleClass="title-label" />
         <Label text="Choose which consoles to export" styleClass="subtitle-label" />
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
         <content>
            <ListView fx:id="listViewConsoles" styleClass="list-view" />
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <VBox spacing="12.0" styleClass="bottom-panel vbox" BorderPane.alignment="CENTER">
         <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="hbox">
            <RadioButton fx:id="radioButtonOnlyNew" text="Only add new" selected="true">
               <toggleGroup>
                  <ToggleGroup fx:id="toggleGroupListType" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="radioButtonRefreshSelected" text="Refresh" toggleGroup="$toggleGroupListType" />
            <CheckBox fx:id="checkBoxOnlyCultes" maxWidth="Infinity" prefWidth="320.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" />
            <Button fx:id="buttonAction" text="Export" onAction="#handleActionButton" prefWidth="140.0" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>
